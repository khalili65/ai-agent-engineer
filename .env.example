# Copy this file to .env and fill in ONE provider.
# Never share your .env file and never commit it (it is already in .gitignore).

# Your API key. OpenAI: sk-...   OpenRouter: sk-or-...   Ollama: write the word ollama
OPENAI_API_KEY=

# Where the model lives. For OpenAI, keep this line commented out (it starts with #).
# For OpenRouter or Ollama, remove the # at the start of ONE line below.
# OPENAI_BASE_URL=https://openrouter.ai/api/v1
# OPENAI_BASE_URL=http://localhost:11434/v1

# Which model to use.
#   OpenAI: gpt-4o-mini
#   OpenRouter: openai/gpt-4o-mini   (or a free model, e.g. nvidia/nemotron-3-super-120b-a12b:free)
#   Ollama: llama3.2:3b
MODEL=gpt-4o-mini
